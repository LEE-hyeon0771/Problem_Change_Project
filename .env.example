# 이 파일을 복사해서 ".env" 라는 이름으로 저장한 뒤, 아래 API 키를 채워 주세요.
# (dev.bat / dev.sh 를 처음 실행하면 자동으로 복사해 줍니다.)

# ---------------------------------------------------------------------------
# 필수: Google Gemini API 키
# ---------------------------------------------------------------------------
# 발급 방법
#   1) https://aistudio.google.com/apikey 접속
#   2) 구글 계정으로 로그인
#   3) "Create API key" 클릭
#   4) 만들어진 키를 복사해서 아래 = 뒤에 붙여넣기 (따옴표 없이)
#
# 예시: GOOGLE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# 아래는 그대로 두셔도 됩니다.
# ---------------------------------------------------------------------------

# 사용할 모델
GEMINI_MODEL=gemini-3-flash-preview

# 앱 환경
APP_ENV=dev
LOG_LEVEL=INFO

# 생성 옵션
DEFAULT_TEMPERATURE=0.6
DEFAULT_MAX_OUTPUT_TOKENS=20000
USE_LLM_GENERATION=true
# LLM 호출 실패 시 재시도 횟수(최초 1회 + 재시도 N회). 0~3.
LLM_MAX_RETRIES=1
# 요청 1건당 LLM 호출 상한. 재시도가 겹쳐 비용이 폭주하는 것을 막습니다.
# 정상 성공은 보통 2~5회입니다. 0이면 무제한.
LLM_MAX_CALLS_PER_REQUEST=12

# 품질 자체 점검(켜면 느려지고 비용이 늘어납니다)
ENABLE_SELF_CHECK=false

# 저장
ENABLE_PROBLEM_PERSISTENCE=true
ENABLE_DB_PERSISTENCE=false
DATABASE_URL=
DATABASE_ECHO=false

# 토큰 사용량 / 비용 로그 (problem_log/ 에 쌓입니다)
ENABLE_USAGE_LOG=true
USAGE_LOG_DIR=problem_log
# 0이면 내장 단가표를 씁니다. 실제 청구 단가와 다르면 여기에 직접 적으세요.
LLM_INPUT_PRICE_PER_MTOK=0.0
LLM_OUTPUT_PRICE_PER_MTOK=0.0
# 0이 아니면 로그에 원화 환산도 같이 남깁니다. (예: 1400)
USD_KRW_RATE=0.0
